# Dominio con HTTPS (obligatorio para instalar la PWA y para Google).
DOMAIN=movo.tudominio.com

# ID de cliente OAuth de Google (tipo "Aplicación web"). Ver docs/DESPLIEGUE.md.
GOOGLE_CLIENT_ID=

# Respaldo en la nube por usuario (MongoDB). false (por defecto) = el servidor no guarda datos y la app oculta la opción.
CLOUD_SYNC=false

# Tipo de cambio del BCCR (opcional): token de la API del SDDE. Sin esto se usa FX_FALLBACK.
BCCR_TOKEN=
FX_FALLBACK=510

# Solicitudes por minuto por usuario al endpoint de respaldo.
RATE_LIMIT_PER_MIN=60
