# Copia este archivo como .env y complétalo. El .env nunca se sube al repositorio (está en .gitignore).

# Dominio con HTTPS (obligatorio para instalar la PWA y para Google).
DOMAIN=movo.tudominio.com

# ID de cliente OAuth de Google (tipo "Aplicación web"). Ver docs/DESPLIEGUE.md.
GOOGLE_CLIENT_ID=

# Respaldo en la nube por usuario (MongoDB). false (por defecto) = el servidor no guarda datos y la app oculta la opción.
CLOUD_SYNC=false

# MongoDB, para el respaldo (solo se usa con CLOUD_SYNC=true).
# Con docker compose déjalo vacío: usa el contenedor "mongo". En desarrollo: mongodb://localhost:27017/movo.
# Con Atlas: la cadena "mongodb+srv://..." que da Atlas, con la base /movo al final (nunca la subas al repositorio).
MONGO_URL=

# Redis, para la caché del tipo de cambio y de los tokens, y el límite de solicitudes.
# Con docker compose no hace falta: usa el contenedor "redis". En desarrollo: redis://localhost:6379.
# Vacío = caché en la memoria del proceso.
REDIS_URL=

# Tipo de cambio del BCCR (opcional): token de la API del SDDE. Sin esto se usa FX_FALLBACK.
BCCR_TOKEN=
FX_FALLBACK=510
# Córdobas por dólar (oficial del Banco Central de Nicaragua, fijo en 2026). Convierte las compras en córdobas.
NIO_PER_USD=36.6243

# Solicitudes por minuto por usuario al endpoint de respaldo.
RATE_LIMIT_PER_MIN=60

# Puerto de la API.
PORT=3000

# Carpeta con la app compilada, para que la API también la sirva (opcional, por ejemplo ../web/dist).
# Vacío = la API solo responde /api; la app la sirve Caddy o Vite.
SERVE_STATIC=

# Solo para `npm run dev`: a dónde reenvía Vite las llamadas a /api (por defecto http://localhost:3000).
# Vite la lee de la terminal, no de este archivo: API_URL=http://otro:3000 npm run dev
# API_URL=
