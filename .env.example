# Dominio con HTTPS (obligatorio para instalar la PWA y para Google).
DOMAIN=puraplata.tudominio.com

# ID de cliente OAuth de Google (tipo "Aplicación web"). Ver docs/DESPLIEGUE.md.
GOOGLE_CLIENT_ID=

# Respaldo en la nube por usuario (MongoDB). false = el servidor no guarda datos.
CLOUD_SYNC=true

# Tipo de cambio del BCCR (opcional). Sin esto se usa FX_FALLBACK.
BCCR_EMAIL=
BCCR_TOKEN=
FX_FALLBACK=510

# Solicitudes por minuto por usuario al endpoint de respaldo.
RATE_LIMIT_PER_MIN=60
